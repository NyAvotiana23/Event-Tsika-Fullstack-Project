# Copier ce fichier vers .env (jamais committé) et adapter les valeurs.

# Clé de signature des jetons JWT, 32 caractères minimum. OBLIGATOIRE.
# Générer : openssl rand -base64 48
JWT_KEY=

# Commission de la plateforme sur les billets payants (0.05 = 5 %).
COMMISSION_RATE=0.05

# Port local du site avec docker compose.
WEB_PORT=8080

# --- Hors Docker (dotnet run) : variables ASP.NET équivalentes ---
# Jwt__Key                     (équivalent de JWT_KEY ; en dev : dotnet user-secrets set "Jwt:Key" "...")
# ConnectionStrings__Default   (défaut : Data Source=event-tsika.db)
# Platform__CommissionRate     (défaut : 0.05)
# Cors__Origins__0             (défaut : http://localhost:4200)
